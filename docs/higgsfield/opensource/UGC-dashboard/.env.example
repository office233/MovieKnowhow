# Higgsfield currently uses the authenticated local CLI.
# Prompt improvement uses the public OpenAI Responses API, server-side only.
OPENAI_API_KEY=
OPENAI_PROMPT_MODEL=gpt-5.6-sol

# Use public-demo for a shareable deployment without provider credentials.
UGC_RUNTIME_MODE=local-cli
NEXT_PUBLIC_UGC_RUNTIME_MODE=local-cli

# Future direct Higgsfield HTTP API integration:
# HIGGSFIELD_API_KEY=
